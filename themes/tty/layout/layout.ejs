<%
  // 由 scripts/tty-theme.js 生成：变体样式表的路径（含哈希，便于缓存失效）
  // 配色变体样式表：由站点 scripts/theme-colors.js 在 before_generate 阶段写入 theme 配置
  var themeLocals = (theme && theme.__css) || null;
  var bodyCls = page.body_class ? [page.body_class] : [];
  if (theme.scanline === true) bodyCls.push('has-scanline');
  if (theme.grain === true) bodyCls.push('has-grain');
  if (theme.cursor_blink === false) bodyCls.push('no-cursor-blink');
%><!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title + (config.subtitle ? ' · ' + config.subtitle : '') %></title>
  <% if (config.meta_generator) { %><%- meta_generator() %><% } %>
  <% if (page.description || config.description) { %>
  <meta name="description" content="<%= page.description || config.description %>">
  <% } %>
  <% if (page.keywords || config.keywords) { %>
  <meta name="keywords" content="<%= page.keywords || config.keywords %>">
  <% } %>
  <% if (config.author) { %><meta name="author" content="<%= config.author %>"><% } %>

  <meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= page.title || config.title %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <% if (page.description || config.description) { %><meta property="og:description" content="<%= page.description || config.description %>"><% } %>
  <meta name="theme-color" content="<%= theme.bg_color || '#0b0d0c' %>">

  <%- css('css/style.css') %>
  <%- css('css/hljs.css') %>
  <% if (themeLocals) { %><%- css(themeLocals) %><% } %>
  <link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
  <% if (theme.favicon) { %><link rel="icon" href="<%- url_for(theme.favicon) %>"><% } %>
  <% if (is_current('index') || page.is_home) { %>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Blog","name":<%- JSON.stringify(config.title) %>,"url":<%- JSON.stringify(config.url) %><% if (config.author) { %>,"author":{"@type":"Person","name":<%- JSON.stringify(config.author) %>}<% } %>}
  </script>
  <% } %>
  <% if (theme.analytics_script) { %><script defer src="<%- theme.analytics_script %>"></script><% } %>
</head>
<body class="<%= bodyCls.join(' ') %>">
  <a class="skip" href="#main">跳到正文</a>

  <header class="site-head">
    <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页">
      <span class="brand-mark" aria-hidden="true">▍</span><%= config.title %>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <% var menus = theme.menu || {}; Object.keys(menus).forEach(function(label) { %>
        <a href="<%- url_for(menus[label]) %>"<% if (is_current(menus[label])) { %> class="on" aria-current="page"<% } %>><%= label %></a>
      <% }); %>
      <a class="rss" href="<%- url_for('/atom.xml') %>" title="订阅 RSS">rss</a>
    </nav>
  </header>

  <main id="main" class="site-main">
    <%- body %>
  </main>

  <footer class="site-foot">
    <% var links = theme.links || []; if (links.length) { %>
    <div class="foot-links">
      <span class="foot-links-label">友情链接</span>
      <ul>
        <% links.forEach(function(l) { %>
        <li>
          <a href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.name %></a><% if (l.desc) { %><span class="link-desc"><%= l.desc %></span><% } %>
        </li>
        <% }); %>
      </ul>
    </div>
    <% } %>
    <div class="foot-row">
      <span class="foot-cmd"><span class="ps1"><%= theme.prompt || '~' %>$</span> echo "© <%= theme.since || 2026 %>-<%= new Date().getFullYear() %> <%- theme.author || config.author || config.title %>"</span>
      <% if (theme.footer_text) { %><span class="foot-note"><%= theme.footer_text %></span><% } %>
    </div>
    <div class="foot-row dim">
      <span><%- config.title %><%- theme.icp ? ' · <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">' + theme.icp + '</a>' : '' %></span>
      <span>build <time datetime="<%= new Date().toISOString() %>"><%= new Date().toISOString().slice(0, 10) %></time></span>
    </div>
  </footer>

  <script src="<%- url_for('/js/tty.js') %>" defer></script>
</body>
</html>
