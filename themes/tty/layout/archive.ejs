<%
var groups = {};
page.posts.each(function(post) {
  var y = post.date.year();
  if (!groups[y]) groups[y] = [];
  groups[y].push(post);
});
var years = Object.keys(groups).sort(function(a, b) { return b - a; });
%>
<section class="archive">
  <header class="post-head">
    <nav class="crumbs"><a href="<%- url_for('/') %>">~</a><span class="sep">/</span><span class="cur">archives</span></nav>
    <h1 class="post-title">归档</h1>
    <p class="page-desc">共 <span class="num"><%= page.posts.length %></span> 篇，已发布</p>
  </header>

  <div class="archive-tree">
  <% years.forEach(function(y) { %>
    <section class="year">
      <h2 class="year-h"><%= y %><span class="year-c"><%= groups[y].length %></span></h2>
      <ul class="year-list">
      <% groups[y].forEach(function(post, i) { %>
        <li>
          <span class="a-no"><%= groups[y].length - i %></span>
          <time datetime="<%= post.date.toISOString() %>"><%= post.date.format('MM-DD') %></time>
          <a href="<%- url_for(post.path) %>"><%= post.title %></a>
        </li>
      <% }); %>
      </ul>
    </section>
  <% }); %>
  </div>
  <% if (!years.length) { %><p class="empty">还没有文章。</p><% } %>
</section>
