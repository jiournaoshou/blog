<%
var c = theme.comments || {};
var g = c.giscus || {};
%>
<% if (c.provider === 'giscus' && g.repo) { %>
<section class="comments" aria-label="评论">
  <div class="list-head"><span>评论</span><span class="dim">giscus</span></div>
  <script src="https://giscus.app/client.js"
          data-repo="<%= g.repo %>"
          data-repo-id="<%= g.repo_id %>"
          data-category="<%= g.category %>"
          data-category-id="<%= g.category_id %>"
          data-mapping="<%= g.mapping || 'pathname' %>"
          data-strict="0"
          data-reactions-enabled="0"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="<%= g.theme || 'dark_dimmed' %>"
          data-lang="zh-CN"
          data-loading="lazy"
          crossorigin="anonymous"
          async>
  </script>
</section>
<% } %>
