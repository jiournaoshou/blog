<section class="taxonomy">
  <header class="post-head">
    <nav class="crumbs"><a href="<%- url_for('/') %>">~</a><span class="sep">/</span><span class="cur">categories</span></nav>
    <h1 class="post-title">分类</h1>
    <p class="page-desc"><span class="num"><%= site.categories.length %></span> 个分类</p>
  </header>
  <ul class="cat-list">
  <% site.categories.sort('count', -1).each(function(cat) { %>
    <li>
      <a href="<%- url_for(cat.path) %>"><span class="hash">#</span><%= cat.name %></a>
      <span class="c-count"><%= cat.length %></span>
    </li>
  <% }); %>
  </ul>
  <% if (!site.categories.length) { %><p class="empty">还没有分类。</p><% } %>
</section>
